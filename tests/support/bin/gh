#!/bin/sh
set -u

record="${FAKE_RECORD:-}"
if [ -n "$record" ]; then
  {
    echo "cmd: gh"
    echo "cwd: $(pwd -P)"
    for arg in "$@"; do
      printf 'arg: %s\n' "$(printf '%s' "$arg" | tr '\n' ' ')"
    done
  } >>"$record"
fi

key=""
case "${1:-} ${2:-}" in
  "pr list") key="list" ;;
  "pr create") key="create" ;;
  "repo view") key="repo-view" ;;
esac

for want in ${FAKE_FAIL:-}; do
  if [ "$want" = "$key" ]; then
    echo "fake gh $key failed" >&2
    exit 1
  fi
done

if [ -n "${FAKE_DELAY:-}" ]; then
  sleep "$FAKE_DELAY"
fi

case "$key" in
  list)
    if [ -n "${FAKE_EXISTING_PR:-}" ]; then
      echo "$FAKE_EXISTING_PR"
    else
      echo "${FAKE_NO_PR_OUTPUT-null}"
    fi
    ;;
  create)
    if [ -z "${FAKE_SILENT_CREATE:-}" ]; then
      echo "Creating pull request for the branch"
      echo ""
      echo "https://github.com/owner/repo/pull/7"
    fi
    ;;
  repo-view) echo "${FAKE_DEFAULT_BRANCH-main}" ;;
esac

exit 0
